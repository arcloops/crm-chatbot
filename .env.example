# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database (Railway or local Docker)
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public

# Redis (Railway or local Docker)
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible: AWS S3, MinIO, Cloudflare R2)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: set for MinIO / R2
S3_ENDPOINT=
S3_PUBLIC_URL=

# Claude API (Phase 8)
ANTHROPIC_API_KEY=

# Error monitoring (Phase 13) — optional; no-op when unset
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# WhatsApp — Meta Cloud API (LIVE). Leave empty for MOCK.
WHATSAPP_BSP=meta
WHATSAPP_API_KEY=          # Meta system user access token
WHATSAPP_API_SECRET=       # unused for Meta; optional mirror of token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
